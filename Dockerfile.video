FROM node:24-alpine
WORKDIR /app
COPY scripts/cloud-video-server.mjs ./cloud-video-server.mjs
COPY deploy/site-video-config.json ./site-video-config.json
ENV RED_BOOK_VIDEO_RUNTIME=/app
USER node
EXPOSE 5245
HEALTHCHECK --interval=30s --timeout=30s --start-period=20s --retries=3 CMD node --input-type=module -e "const r=await fetch('http://127.0.0.1:5245/api/cloud-video/catalog?subject=zy1');if(!r.ok)process.exit(1)"
CMD ["node", "/app/cloud-video-server.mjs"]
